<?xml version="1.0" encoding="utf-8"?>
<!--
  The app draws edge to edge, because it targets API 36. The padding here is the
  base only: MainActivity adds the window insets to it, so the card clears the
  status bar, the camera cutout, and the navigation bar.
  clipToPadding is false, so the content scrolls under the bars instead of
  stopping short of them.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            layout="@layout/widget_card"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_preview_height" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/block_gap"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/next_quote" />

            <Button
                android:id="@+id/button_add"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/field_gap"
                android:layout_weight="1"
                android:text="@string/add_widget" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="@string/settings" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/field_gap"
            android:text="@string/interval_label" />

        <Spinner
            android:id="@+id/interval_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/block_gap"
            android:text="@string/author_label" />

        <EditText
            android:id="@+id/filter_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/author_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="@color/quote_text"
            android:textColorHint="@color/text_secondary" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/block_gap"
            android:text="@string/work_label" />

        <EditText
            android:id="@+id/filter_work"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/work_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="@color/quote_text"
            android:textColorHint="@color/text_secondary" />

        <Button
            android:id="@+id/button_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/block_gap"
            android:text="@string/apply" />

        <TextView
            android:id="@+id/source_text"
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap" />
    </LinearLayout>
</ScrollView>
