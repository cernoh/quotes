<?xml version="1.0" encoding="utf-8"?>
<!--
  The card. Both the home screen widget and the app draw this layout, so the
  preview in the app is the widget itself and not a copy of it.

  RemoteViews supports a fixed set of views; a plain View is not one of them, so
  the rule under the quote is a TextView with a background colour.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quote_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_background"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/quote_text"
        style="@style/QuoteText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="6" />

    <TextView
        android:id="@+id/quote_rule"
        android:layout_width="@dimen/quote_rule_width"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@color/quote_rule" />

    <LinearLayout
        android:id="@+id/quote_attribution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/quote_author"
            style="@style/QuoteAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/quote_work"
            style="@style/QuoteWork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
