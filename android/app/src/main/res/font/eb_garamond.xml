<?xml version="1.0" encoding="utf-8"?>
<!-- The family name @font/eb_garamond carries both weights, so a TextView with
     android:textStyle="italic" gets the true italic cut. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/eb_garamond_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/eb_garamond_italic"
        android:fontStyle="italic"
        android:fontWeight="400" />
</font-family>
