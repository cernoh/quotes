<?xml version="1.0" encoding="utf-8"?>
<!--
  The sepia palette, taken from the desktop scheme so the phone and the desktop
  read as one print: base #1e1813, surface #241d17, text #ece0cd, primary
  #c99a5b. See android/AGENTS.md for the role names.

  A few numbers come from a design seed, rolled from /dev/urandom as 62314:
  the card radius (12 + seed % 3 * 2 = 14dp) and the alpha of the card and its
  stroke (0.72 + 0.06 * (seed % 3) = 0.78, and 0.32).
-->
<resources>
    <!-- The card floats over wallpaper, so it is a surface at 78 percent. -->
    <color name="card_background">#C7241D17</color>
    <color name="card_stroke">#525F4D3A</color>
    <color name="screen_background">#1E1813</color>

    <color name="quote_text">#ECE0CD</color>
    <color name="quote_author">#C99A5B</color>
    <color name="quote_work">#9C8C74</color>
    <color name="quote_rule">#8CC99A5B</color>
    <color name="text_secondary">#C9B79C</color>

    <!-- The same card as a cream paper, for a light home screen. -->
    <color name="card_background_light">#F2F1E4CE</color>
    <color name="card_stroke_light">#2E5F4D3A</color>
    <color name="quote_text_light">#241D17</color>
    <color name="quote_author_light">#6B4F2A</color>
    <color name="quote_work_light">#5F4D3A</color>
    <color name="quote_rule_light">#8C6B4F2A</color>

    <color name="launcher_background">#1E1813</color>
</resources>
