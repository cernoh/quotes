# Copy this file to android/keystore.properties and fill it in.
#
# The real file is gitignored. The keystore itself lives outside the repository.
# Losing it means this app can never be updated again: Android only accepts an
# update signed by the same key as the installed copy.
#
# Generate a key once, with:
#   keytool -genkeypair -v -keystore ~/.android-keys/quotes-release.jks \
#     -alias quotes -keyalg RSA -keysize 4096 -validity 10000

storeFile=/absolute/path/to/quotes-release.jks
storePassword=change-me
keyAlias=quotes
keyPassword=change-me
